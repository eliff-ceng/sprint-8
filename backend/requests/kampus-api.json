{
  "info": {
    "_postman_id": "9bda1c1a-3f68-4e8e-9b17-7a081d4af321",
    "name": "Kampus API - Sprint 8",
    "description": "Sprint 8: MongoDB ObjectId, Mongoose validation ve 6 Postman istegi. Once npm run seed calistir, sonra 1-6 sirasiyla ilerle. GET /events yaniti eventId degiskenini otomatik kaydeder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Health (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"status ve ogrenci numarasi\", () => { pm.expect(body.status).to.eql(\"ok\"); pm.expect(body.student).to.eql(\"2416501075\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "response": []
    },
    {
      "name": "2 Etkinlik listesi ve id yakala (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Seed sonrasi 6 kayit\", () => pm.expect(data).to.have.length(6));",
              "pm.test(\"MongoDB alanlari\", () => { pm.expect(data[0]).to.have.property(\"_id\"); pm.expect(data[0]).to.have.property(\"createdAt\"); pm.expect(data[0]).to.have.property(\"updatedAt\"); });",
              "if (data.length > 0 && data[0]._id) { pm.collectionVariables.set(\"eventId\", data[0]._id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/events"
      },
      "response": []
    },
    {
      "name": "3 Tek etkinlik - dinamik _id (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"_id dogru\", () => pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get(\"eventId\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/events/{{eventId}}"
      },
      "response": []
    },
    {
      "name": "4 Olmayan veya bozuk id (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Event not found\", () => pm.expect(pm.response.json().error.message).to.eql(\"Event not found\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/events/yok"
      },
      "response": []
    },
    {
      "name": "5 Etkinlik ekle (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "pm.test(\"_id ve createdAt var\", () => { pm.expect(data._id).to.match(/^[a-f0-9]{24}$/i); pm.expect(data.createdAt).to.be.a(\"string\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
